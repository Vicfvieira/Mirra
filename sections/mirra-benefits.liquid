{{ 'mirra-benefits.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign threshold_cents = settings.mirra_free_shipping_threshold | times: 100
  assign threshold_money = threshold_cents | money_without_trailing_zeros
-%}

<section
  class="mirra-section mirra-benefits color-{{ section.settings.color_scheme }} gradient"
  style="--mirra-pt: {{ section.settings.padding_top }}px; --mirra-pb: {{ section.settings.padding_bottom }}px;"
  {% if section.settings.heading != blank %}
    aria-labelledby="MirraBenefitsTitle-{{ section.id }}"
  {% else %}
    aria-label="{{ section.settings.accessible_label | escape }}"
  {% endif %}
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 id="MirraBenefitsTitle-{{ section.id }}" class="mirra-title mirra-title--md mirra-benefits__heading">
        {{- section.settings.heading -}}
      </h2>
    {%- endif -%}
    <ul class="mirra-benefits__list mirra-benefits__list--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        <li class="mirra-benefits__item" {{ block.shopify_attributes }}>
          <span class="mirra-benefits__icon">
            {%- render 'mirra-icon', icon: block.settings.icon, size: 28 -%}
          </span>
          <div class="mirra-benefits__text">
            <p class="mirra-benefits__title">{{ block.settings.title | replace: '[frete]', threshold_money }}</p>
            {%- if block.settings.text != blank -%}
              <p class="mirra-benefits__desc">{{ block.settings.text | replace: '[frete]', threshold_money }}</p>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "MIRRA — Benefícios",
  "tag": "div",
  "class": "mirra-benefits-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "paragraph",
      "content": "Dica: escreva [frete] no texto para mostrar automaticamente o valor de frete grátis definido em Configurações do tema › MIRRA — Loja."
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título (opcional)"
    },
    {
      "type": "text",
      "id": "accessible_label",
      "label": "Nome da seção para leitores de tela",
      "info": "Usado quando não há título visível.",
      "default": "Benefícios da loja"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espaço superior",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Espaço inferior",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefício",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Ícone",
          "options": [
            { "value": "caminhao", "label": "Caminhão" },
            { "value": "mapa", "label": "Mapa" },
            { "value": "cartao", "label": "Cartão" },
            { "value": "troca", "label": "Troca" },
            { "value": "presente", "label": "Presente" },
            { "value": "gota", "label": "Gota" },
            { "value": "folha", "label": "Folha" },
            { "value": "chama", "label": "Chama" },
            { "value": "coracao", "label": "Coração" }
          ],
          "default": "caminhao"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Frete grátis acima de [frete]"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Para compras em todo o site"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MIRRA — Benefícios",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "caminhao", "title": "Frete grátis acima de [frete]", "text": "Calculado automaticamente no carrinho" } },
        { "type": "benefit", "settings": { "icon": "mapa", "title": "Entrega para todo o Brasil", "text": "Enviamos com rastreio em até 2 dias úteis" } },
        { "type": "benefit", "settings": { "icon": "cartao", "title": "Até 6x sem juros", "text": "No cartão, ou 5% off no Pix" } },
        { "type": "benefit", "settings": { "icon": "troca", "title": "Troca fácil", "text": "7 dias para trocar ou devolver" } }
      ]
    }
  ]
}
{% endschema %}
