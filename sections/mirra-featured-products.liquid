{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'mirra-featured-products.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- liquid
  assign collection = section.settings.collection
  assign skip_card_product_styles = false
  if section.settings.enable_quick_add
    assign quick_add = 'standard'
  else
    assign quick_add = 'none'
  endif
  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and collection != blank
    assign view_all_url = collection.url
  endif
-%}

<section
  class="mirra-section mirra-featured-products color-{{ section.settings.color_scheme }} gradient"
  style="--mirra-pt: {{ section.settings.padding_top }}px; --mirra-pb: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="MirraFeaturedTitle-{{ section.id }}"
>
  <div class="page-width">
    <div class="mirra-section__header mirra-section__header--split">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mirra-eyebrow">
            {%- render 'mirra-icon', icon: 'estrela', size: 16 -%}
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}
        <h2 id="MirraFeaturedTitle-{{ section.id }}" class="mirra-title mirra-title--lg">
          {{- section.settings.heading -}}
        </h2>
      </div>
      {%- if section.settings.view_all_label != blank and view_all_url != blank -%}
        <a href="{{ view_all_url }}" class="mirra-link-arrow">
          {{- section.settings.view_all_label | escape -}}
          {%- render 'mirra-icon', icon: 'seta', size: 20 -%}
        </a>
      {%- endif -%}
    </div>

    <ul
      class="grid product-grid contains-card contains-card--product contains-card--standard grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop mirra-featured-products__grid"
      role="list"
    >
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <li class="grid__item">
            {% render 'card-product',
              card_product: product,
              media_aspect_ratio: section.settings.image_ratio,
              image_shape: 'default',
              lazy_load: true,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: false,
              show_rating: section.settings.show_rating,
              skip_styles: skip_card_product_styles,
              section_id: section.id,
              quick_add: quick_add,
              product_view_context: 'collection'
            %}
          </li>
          {%- assign skip_card_product_styles = true -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.products_to_show) -%}
          {%- capture placeholder_image -%}product-{% cycle 1, 2, 3, 4, 5, 6 %}{%- endcapture -%}
          <li class="grid__item">
            {% render 'card-product',
              media_aspect_ratio: section.settings.image_ratio,
              lazy_load: false,
              placeholder_image: placeholder_image
            %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "MIRRA — Mais vendidos",
  "tag": "div",
  "class": "mirra-featured-products-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Chamada acima do título",
      "default": "Queridinhos da comunidade"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Título",
      "info": "Use itálico para destacar uma palavra em mel.",
      "default": "Os <em>mais</em> amados"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção",
      "info": "Sugestão: coleção automática com a tag \"mais-vendido\"."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Quantidade de produtos",
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Colunas no desktop",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Colunas no celular",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporção da imagem",
      "options": [
        { "value": "portrait", "label": "Retrato 4:5" },
        { "value": "square", "label": "Quadrada" },
        { "value": "adapt", "label": "Adaptar à imagem" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Mostrar segunda imagem ao passar o mouse",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar avaliação",
      "info": "Requer um app de avaliações.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Botão de compra rápida",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto do link \"ver todos\"",
      "default": "Ver todos"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "Link \"ver todos\"",
      "info": "Se vazio, usa o link da coleção."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de cores",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Espaço superior",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Espaço inferior",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "MIRRA — Mais vendidos"
    }
  ]
}
{% endschema %}
