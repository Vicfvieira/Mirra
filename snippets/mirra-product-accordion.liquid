{% comment %}
  MIRRA — acordeão de produto que lê um metafield (bloco "MIRRA — Acordeão").
  Usa o metafield do produto se existir; senão, o texto de reserva; sem nenhum dos dois, não renderiza.

  Accepts:
  - block: {Object} bloco mirra_accordion
  - product: {Object} produto
  - section_id: {String} id da seção

  Usage:
  {% render 'mirra-product-accordion', block: block, product: product, section_id: section.id %}
{% endcomment %}

{%- liquid
  assign content = ''
  assign metafield_path = block.settings.metafield | strip
  if metafield_path contains '.'
    assign path_parts = metafield_path | split: '.'
    assign metafield = product.metafields[path_parts[0]][path_parts[1]]
    if metafield.value != blank
      assign content = metafield | metafield_tag
    endif
  endif
  if content == blank
    assign content = block.settings.fallback
  endif
-%}

{%- if content != blank -%}
  <div class="product__accordion accordion quick-add-hidden mirra-accordion" {{ block.shopify_attributes }}>
    <details
      id="Details-{{ block.id }}-{{ section_id }}"
      {% if block.settings.open %}
        open
      {% endif %}
    >
      <summary>
        <div class="summary__title">
          <span class="mirra-accordion__icon">{% render 'mirra-icon', icon: block.settings.icon, size: 22 %}</span>
          <h2 class="h4 accordion__title">{{ block.settings.heading | escape }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section_id }}">
        {{ content }}
      </div>
    </details>
  </div>
{%- endif -%}
