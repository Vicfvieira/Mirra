{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "badges": {
          "type": "mirra_badges",
          "settings": {
            "text_1": "100% vegano",
            "icon_1": "folha",
            "text_2": "Feito à mão",
            "icon_2": "coracao",
            "text_3": "Sem parabenos",
            "icon_3": "gota",
            "text_4": "",
            "icon_4": "none",
            "only_tag": "",
            "show_status_badges": true
          }
        },
        "price": {
          "type": "price"
        },
        "installments": {
          "type": "mirra_installments",
          "settings": {
            "pix_text": "5% off no Pix"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "tab_uso": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Modo de uso",
            "icon": "perfume",
            "content": "{{ product.metafields.custom.modo_de_uso | metafield_tag }}",
            "page": ""
          }
        },
        "tab_ingredientes": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Ingredientes",
            "icon": "leaf",
            "content": "{{ product.metafields.custom.ingredientes | metafield_tag }}",
            "page": ""
          }
        },
        "tab_envio": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Envio e trocas",
            "icon": "truck",
            "content": "<p>Enviamos para todo o Brasil em até 2 dias úteis após a confirmação do pagamento, com código de rastreio por e-mail. Frete grátis em compras acima de R$ 199.</p><p>Você tem 7 dias após o recebimento para trocar ou devolver (produto lacrado). Fale com a gente pelo contato.</p>",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Compartilhar"
          }
        }
      },
      "block_order": [
        "title",
        "badges",
        "price",
        "installments",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "tab_uso",
        "tab_ingredientes",
        "tab_envio",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 48,
        "padding_bottom": 48
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Combina com seu <em>ritual</em>",
        "heading_size": "h1",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 72,
        "padding_bottom": 72
      }
    },
    "sticky-buy": {
      "type": "mirra-product-sticky-bar",
      "settings": {
        "show_on_desktop": false,
        "color_scheme": "scheme-1"
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products",
    "sticky-buy"
  ]
}
